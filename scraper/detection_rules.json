  "buy_now": {
    "css_selectors": [
      "#buy-now",
      "#buy-now-button",
      ".buy-now",
      ".buy-now-button",
      "button[id*='buy-now']",
      "button[class*='buy-now']",
      "button[id*='buyNow']",
      "button[class*='buyNow']",
      "[data-action='buy-now']",
      "[data-button-type='buy-now']",
      "[aria-label*='Buy Now']",
      "[data-testid*='buy-now']",
      "button[class*='BuyNow']",
      "button[class*='CheckoutButton']"
    ],
    "text_patterns": [
      "buy now",
      "buy it now",
      "buy instantly",
      "instant buy",
      "order now",
      "purchase now",
      "checkout now",
      "comprar ahora",
      "acheter maintenant",
      "jetzt kaufen",
      "acquista ora",
      "pre-order",
      "preorder",
      "reserve now",
      "pre order now"
    ],
    "domains": {
      "amazon.com": {
        "selectors": [
          "#buy-now-button",
          "input#buy-now-button",
          "#one-click-button",
          "button[id*='buy-now']"
        ],
        "text": ["Buy Now", "Buy now"]
      },
      "ebay.com": {
        "selectors": [
          "a[id*='binBtn']",
          "a[data-action*='buy-now']",
          ".binBtn"
        ],
        "text": ["Buy It Now", "Buy it now"]
      },
      "walmart.com": {
        "selectors": [
          "button[data-automation-id='buy-now']",
          "button[data-tl-id='ProductBuyNow']"
        ],
        "text": ["Buy Now"]
      },
      "target.com": {
        "selectors": ["button[data-test='buyNowButton']"],
        "text": ["Buy Now"]
      },
      "bestbuy.com": {
        "selectors": ["button.buy-now-button"],
        "text": ["Buy Now"]
      }
    }
  },
  "settings": {
    "case_sensitive": false,
    "partial_match": true,
    "timeout": 30,
    "wait_for_dynamic_content": 2
  }
